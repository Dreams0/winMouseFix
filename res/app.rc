#include "resource.h"

IDI_APP ICON "res/app.ico"

1 24 "res/app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Dreams0"
            VALUE "FileDescription", "winMouseFix - smooth wheel scrolling"
            VALUE "FileVersion", "1.0"
            VALUE "InternalName", "winMouseFix"
            VALUE "OriginalFilename", "winMouseFix.exe"
            VALUE "ProductName", "winMouseFix"
            VALUE "LegalCopyright", "Copyright (C) 2026 Dreams0"
            VALUE "Comments", "https://github.com/Dreams0/winMouseFix"
            VALUE "ProductVersion", "V1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
